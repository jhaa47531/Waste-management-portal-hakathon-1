rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Municipal Localities: Active records readable by any user for service registration;
    // creation and updates restricted to authorized administrators.
    match /localities/{localityId} {
      allow read: if resource == null || resource.data.active == true;
      allow write: if request.auth != null && 
        (request.auth.token.role in ['admin', 'administrator'] || 
         request.auth.token.email == 'jhaa47531@gmail.com');
    }

    // Default rule for application documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
